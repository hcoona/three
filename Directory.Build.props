<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <CurrentTargetFramework>net10.0</CurrentTargetFramework>
    <CurrentWpfTargetFramework>net10.0-windows</CurrentWpfTargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ProduceReferenceAssembly Condition="'$(MSBuildProjectExtension)' == '.csproj'">true</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile Condition="'$(RestorePackagesWithLockFile)' == '' and '$(MSBuildProjectExtension)' != '.proj'">true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == '' and ('$(TF_BUILD)' == 'true' or '$(ContinuousIntegrationBuild)' == 'true')">true</RestoreLockedMode>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <RestoreEnablePackagePruning>true</RestoreEnablePackagePruning>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <EnablePackageVersionOverride>false</EnablePackageVersionOverride>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <PropertyGroup Label="Code Analysis" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <Sdk Name="DotNet.ReproducibleBuilds.Isolated" />
  <Sdk Name="Microsoft.Build.CopyOnWrite" />

  <ItemGroup>
    <GlobalPackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.2" />
    <GlobalPackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.202" />
  </ItemGroup>

  <PropertyGroup Label="SourceLink">
    <ProjectUrl>https://github.com/hcoona/three</ProjectUrl>
    <PackageProjectUrl>https://github.com/hcoona/three</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hcoona/three.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="NuPack">
    <Authors>Shuai Zhang</Authors>
    <Company>Shuai Zhang</Company>
    <Copyright>Copyright (c) Shuai Zhang 2025</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later WITH LGPL-3.0-linking-exception</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <DebugType>portable</DebugType>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Label="CI" Condition="'$(ContinuousIntegrationBuild)' == 'true' or '$(TF_BUILD)' == 'true'">
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>
</Project>
