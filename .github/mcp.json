{
  "mcpServers": {
    "playwright": {
      "type": "local",
      "tools": [
        "*"
      ],
      "id": "",
      "command": "mise",
      "args": [
        "run",
        "--raw",
        "--quiet",
        "playwright-mcp"
      ]
    },
    "context7": {
      "type": "local",
      "tools": [
        "*"
      ],
      "id": "",
      "command": "mise",
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "args": [
        "exec",
        "--",
        "pnpm",
        "dlx",
        "@upstash/context7-mcp@3.2.5"
      ]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "tools": [
        "*"
      ],
      "id": ""
    },
    "binlog": {
      "type": "local",
      "tools": [
        "*"
      ],
      "id": "",
      "command": "mise",
      "args": [
        "exec",
        "--",
        "dotnet",
        "dnx",
        "Microsoft.AITools.BinlogMcp",
        "--yes"
      ]
    }
  }
}
