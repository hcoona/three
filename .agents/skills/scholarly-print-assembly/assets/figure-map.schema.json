{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcoona.github.io/schemas/scholarly-publication/figure-map-1.0.json",
  "title": "Scholarly publication figure map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinate_space", "figures"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "coordinate_space": {
      "const": "pdf-points-top-left"
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parts"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "source_label": {
            "type": ["string", "null"]
          },
          "profile": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "embedded_language_inventory": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "order", "pdf_page", "bbox"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        }
      }
    }
  }
}
