root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[LICENSE*]
indent_size = unset

[THIRD-PARTY-NOTICES.TXT]
indent_size = unset

[*.md]
indent_size = 4

[*.ps1]
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.ipynb]
indent_size = unset

[*.cs]
indent_size = 4
