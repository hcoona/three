<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Hcoona.ReleaseSmoke.GithubPackages</PackageId>
    <AssemblyName>Hcoona.ReleaseSmoke.GithubPackages</AssemblyName>
    <RootNamespace>HcoonaReleaseSmokeGithubPackages</RootNamespace>
    <Description>Operator-controlled Workflow Delivery v3 NuGet smoke marker.</Description>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DeterministicTimestamp Condition="'$(Deterministic)' == 'true' and '$(DeterministicTimestamp)' == '' and '$(SOURCE_DATE_EPOCH)' == ''">315532800</DeterministicTimestamp>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
