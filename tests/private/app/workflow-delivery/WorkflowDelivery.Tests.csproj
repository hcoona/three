<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>$(CurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);fixtures/products/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/private/app/workflow-delivery/WorkflowDelivery.csproj" />
    <Reference Include="Microsoft.Build" HintPath="$(MSBuildBinPath)/Microsoft.Build.dll" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)/Microsoft.Build.Framework.dll" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)/Microsoft.Build.Utilities.Core.dll" />
    <PackageReference Include="NuGet.ProjectModel" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="NuGet.Frameworks" />
    <EmbeddedResource Include="Repository/fixtures/*.json" />
    <EmbeddedResource Include="fixtures/products/hcoona-release-smoke-npm/version.json"
                      LogicalName="NpmFixtureVersionConfiguration" />
  </ItemGroup>
  <Target Name="ReferenceOfficialNbgv" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(NerdbankGitVersioningTasksPath)' == ''" Text="The official NBGV task path is unavailable." />
    <ItemGroup>
      <Reference Include="Nerdbank.GitVersioning">
        <HintPath>$(NerdbankGitVersioningTasksPath)Nerdbank.GitVersioning.dll</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
