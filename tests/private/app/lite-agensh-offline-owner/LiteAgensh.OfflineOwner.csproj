    <Compile Include="..\lite-agensh\Support\ObservedManualClock.cs" Link="Support\ObservedManualClock.cs" />
    <Compile Include="..\lite-agensh\Support\ManualScenarioClock.cs" Link="Support\ManualScenarioClock.cs" />
    <Compile Include="..\lite-agensh\Support\ControlledSessionPool.cs" Link="Support\ControlledSessionPool.cs" />
