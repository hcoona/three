amends "src/private/lib/hk/Config.pkl"

import "src/private/lib/hk/Steps.pkl"

min_hk_version = "1.56.1"
display_skip_reasons =
  List(
    "profile-not-enabled",
    "profile-explicitly-disabled",
    "no-command-for-run-type",
    "no-files-to-process",
    "condition-false",
    "disabled-by-env",
    "disabled-by-cli",
  )
warnings = List("missing-profiles")

local apm_generated_output_list =
  List(
    ".agents/**",
    ".vscode/mcp.json",
    "apm.lock.yaml",
    "**/apm.lock.yaml",
  )

local general_exclude_list =
  List(
    "**/packages.lock.json",
    "global.json",
    "project.assets.json",
    "package-lock.json",
    "PklProject.deps.json",
    "pnpm-lock.yaml",
    "**/pnpm-lock.yaml",
    "uv.lock",
    "mise.lock",
    "**/mise.lock",
    "**/.github/**",
    "**/.specify/**",
    "**/specs/**/*.md",
    "**/generated/**",
  ) + apm_generated_output_list

local general_linters = new Mapping<String, Step> {
  ["typos"] = (Steps.typos) {
    profiles = List("small")
    exclude = general_exclude_list
  }

  ["editorconfig-check"] = (Steps.editorconfig_check) {
    profiles = List("medium")
    exclude = general_exclude_list
    check = "python eng/scripts/hk_exec.py editorconfig-checker --disable-indent-size -- {{files}}"
  }
}

local pipeline_linters = new Mapping<String, Step> {
  ["actionlint"] {
    profiles = List("small")
    glob = List("**/.github/workflows/*.yml", "**/.github/workflows/*.yaml")
    check = "python eng/scripts/hk_actionlint.py {{files}}"
  }
}

local markdown_linters = new Mapping<String, Step> {
  local markdown_append_only_artifact_exclude = List(".testagent/**")

  ["markdownlint-cli2"] {
    profiles = List("small")
    exclude = general_exclude_list + markdown_append_only_artifact_exclude
    batch = true
    glob = List("*.md")
    stage = List("*.md")
    check = "python eng/scripts/hk_exec.py pnpm exec -- markdownlint-cli2 -- {{files}}"
    fix = "python eng/scripts/hk_exec.py pnpm exec -- markdownlint-cli2 --fix -- {{files}}"
  }

  ["markdown-prettier"] {
    profiles = List("small")
    exclude = general_exclude_list + markdown_append_only_artifact_exclude
    glob = List("*.md")
    stage = List("*.md")
    check = "python eng/scripts/hk_exec.py pnpm exec -- prettier --check -- {{files}}"
    fix = "python eng/scripts/hk_exec.py pnpm exec -- prettier --write -- {{files}}"
  }
}

local pkl_linters = new Mapping<String, Step> {
  ["pkl-eval"] = (Steps.pkl_eval) {
    profiles = List("small")
  }

  ["pkl-format"] = (Steps.pkl_format) {
    profiles = List("small")
  }
}

local json_linters = new Mapping<String, Step> {
  ["json-biome"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("*.json", "*.jsonc")
    stage = List("*.json", "*.jsonc")
    check =
      "python eng/scripts/hk_exec.py pnpm exec -- biome check --no-errors-on-unmatched -- {{files}}"
    fix =
      "python eng/scripts/hk_exec.py pnpm exec -- biome check --write --no-errors-on-unmatched -- {{files}}"
  }
}

local yaml_linters = new Mapping<String, Step> {
  ["yaml-prettier"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("*.yml", "*.yaml")
    stage = List("*.yml", "*.yaml")
    check = "python eng/scripts/hk_exec.py pnpm exec -- prettier --check -- {{files}}"
    fix = "python eng/scripts/hk_exec.py pnpm exec -- prettier --write -- {{files}}"
  }
}

local toml_linters = new Mapping<String, Step> {
  ["toml-taplo-check"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("**/*.toml")
    check = "python eng/scripts/hk_exec.py pnpm exec -- taplo check -- {{files}}"
  }

  ["toml-taplo-format"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("**/*.toml")
    stage = List("<JOB_FILES>")
    check = "python eng/scripts/hk_exec.py pnpm exec -- taplo format --check -- {{files}}"
    check_diff =
      "python eng/scripts/hk_exec.py pnpm exec -- taplo format --check --diff -- {{files}}"
    fix = "python eng/scripts/hk_exec.py pnpm exec -- taplo format -- {{files}}"
  }
}

local docker_linters = new Mapping<String, Step> {
  ["hadolint"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("Dockerfile", "*.Dockerfile", "Dockerfile.*")
    check = "python eng/scripts/hk_exec.py hadolint -- {{files}}"
  }
}

local bash_linters = new Mapping<String, Step> {
  ["shellcheck"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("**/*.sh", "**/*.bash")
    check = "python eng/scripts/hk_exec.py shellcheck -- {{files}}"
  }

  ["shfmt"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("**/*.sh", "**/*.bash", "**/*.mksh", "**/*.bats", "**/*.zsh")
    check = "python eng/scripts/hk_exec.py shfmt -d --apply-ignore -- {{files}}"
    fix = "python eng/scripts/hk_exec.py shfmt -w --apply-ignore -- {{files}}"
  }
}

local pwsh_linters = new Mapping<String, Step> {
  local powershell_files = List("*.ps1", "*.psm1", "*.psd1")

  ["pwsh-formatter"] {
    profiles = List("medium")
    exclude = general_exclude_list
    batch = true
    glob = powershell_files
    stage = powershell_files
    env {
      ["HK_EXEC_PER_FILE"] = "0"
    }
    check =
      "python eng/scripts/hk_exec.py pwsh -NoLogo -NoProfile -NonInteractive -File eng/linter/Invoke-FormatterWrapper.ps1 -Mode Check -Path -- {{files}}"
    fix =
      "python eng/scripts/hk_exec.py pwsh -NoLogo -NoProfile -NonInteractive -File eng/linter/Invoke-FormatterWrapper.ps1 -Mode Fix -Path -- {{files}}"
  }

  ["pwsh-script-analyzer"] {
    profiles = List("medium")
    exclude = general_exclude_list
    batch = true
    glob = powershell_files
    stage = powershell_files
    env {
      ["HK_EXEC_PER_FILE"] = "0"
      ["HK_EXEC_TIMEOUT_SECONDS"] = "300"
    }
    check =
      "python eng/scripts/hk_exec.py pwsh -NoLogo -NoProfile -NonInteractive -File eng/linter/Invoke-ScriptAnalyzerWrapper.ps1 -Mode Check -Path -- {{files}}"
    fix =
      "python eng/scripts/hk_exec.py pwsh -NoLogo -NoProfile -NonInteractive -File eng/linter/Invoke-ScriptAnalyzerWrapper.ps1 -Mode Fix -Path -- {{files}}"
  }
}

local dotnet_linters = new Mapping<String, Step> {
  ["csharpier"] = (Steps.csharpier) {
    profiles = List("medium")
    exclude = general_exclude_list
    prefix = "dotnet tool run"
  }

  ["dotnet-lock-verify"] = (Steps.dotnet_lock_verify) {
    profiles = List("medium")
  }
}

local javascript_typescript_linters = new Mapping<String, Step> {
  local javascript_files = List("*.js", "*.cjs", "*.mjs", "*.jsx")
  local typescript_files = List("*.ts", "*.cts", "*.mts", "*.tsx")
  local javascript_typescript_files = javascript_files + typescript_files

  ["biome"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = javascript_typescript_files
    stage = javascript_typescript_files
    check =
      "python eng/scripts/hk_exec.py pnpm exec -- biome check --no-errors-on-unmatched -- {{files}}"
    fix =
      "python eng/scripts/hk_exec.py pnpm exec -- biome check --write --no-errors-on-unmatched -- {{files}}"
  }
}

local python_linters = new Mapping<String, Step> {
  local python_files = List("*.py", "*.pyi")
  local python_notebook_files = List("*.ipynb")
  local all_python_files = python_files + python_notebook_files
  local python_exclude_list =
    general_exclude_list + List("src/private/lib/scan-restoration/skills/**")

  ["ruff"] {
    profiles = List("small")
    exclude = python_exclude_list
    glob = all_python_files
    stage = all_python_files
    check = "python eng/scripts/hk_exec.py uv run ruff check --force-exclude -- {{files}}"
    fix = "python eng/scripts/hk_exec.py uv run ruff check --force-exclude --fix -- {{files}}"
  }

  ["ruff_format"] {
    profiles = List("small")
    exclude = python_exclude_list
    glob = all_python_files
    stage = all_python_files
    check =
      "python eng/scripts/hk_exec.py uv run ruff format --quiet --force-exclude --check -- {{files}}"
    check_diff =
      "python eng/scripts/hk_exec.py uv run ruff format --quiet --force-exclude --diff -- {{files}}"
    fix = "python eng/scripts/hk_exec.py uv run ruff format --quiet --force-exclude -- {{files}}"
  }
}

local workflow_delivery_v3_impact = new Mapping<String, Step> {
  // These engineering components own prose separately from executable inputs.
  // Keep unknown files selected; only their declared prose locations opt out.
  local engineering_roots =
    List(
      "src/public/lib/three-workflow-delivery-v3",
      "src/private/app/workflow-delivery-v3-nuget-authority",
      "src/private/app/workflow-delivery-v3-dotnet-provider",
      "src/private/lib/hk",
    )
  local narrative_documents =
    new Listing<String> {
      for (root in engineering_roots) {
        "\(root)/README.md"
        "\(root)/docs/**/*.md"
      }
    }.toList()

  local implementation_inputs =
    engineering_roots.map((root) -> root + "/**")
      + List(
        // Smoke packages and captured fixtures include executable/packaged Markdown.
        "src/public/lib/hcoona-release-smoke-npm/**",
        "src/public/lib/hcoona-release-smoke-github-packages/**",
        "eng/scripts/workflow_delivery_v3_*",
      )

  local contract_inputs =
    List(
      ".github/CODEOWNERS",
      ".github/actions/workflow-delivery-v3-*/**",
      ".github/actions/workflow-delivery-v3/**",
      ".github/workflow-delivery/governance/hcoona-release-smoke-npm.json",
      ".github/workflow-delivery/governance/hcoona-release-smoke-github-packages.json",
      ".github/workflows/*.yaml",
      ".github/workflows/*.yml",
      // Retirement notices are read by the legacy-boundary contract tests.
      ".github/workflows/REFACTOR_PLAN.md",
      ".github/workflows/docs/DESIGN.prompt.md",
      ".github/workflows/docs/DESIGN.v2.md",
      ".github/workflows/docs/MEMORY.md",
      "eng/workflow-delivery/v3/**",
      "src/**/workflow-delivery.quality.yml",
      "src/**/workflow-delivery.release-unit.yml",
      // The static-reference regression suite reads this real workspace fixture.
      "src/public/lib/hexo-renderer-asciidoc/examples/hexo-site/package.json",
      "src/public/lib/hexo-renderer-asciidoc/examples/hexo-site/pnpm-lock.yaml",
    )

  // Native helper and smoke builds inherit configuration along these ancestors.
  local dotnet_configuration_inputs =
    new Listing<String> {
      for (
        directory in
          List("", "src/", "src/private/", "src/private/app/", "src/public/", "src/public/lib/")
      ) {
        "\(directory)Directory.Build.*"
        "\(directory)Directory.Packages.props"
        "\(directory).editorconfig"
        "\(directory)global.json"
        "\(directory)nuget.config"
        "\(directory)version.json"
      }
    }.toList()

  local execution_inputs =
    dotnet_configuration_inputs
      + List(
        ".config/dotnet-tools.json",
        ".gitattributes",
        ".gitignore",
        ".npmrc",
        ".python-version",
        ".typos.toml",
        "conftest.py",
        "eng/scripts/hk_*.py",
        "hk.pkl",
        "mise.lock",
        "mise.toml",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "pyproject.toml",
        "pyrefly.toml",
        "pytest.ini",
        "ruff.toml",
        "stylecop.json",
        "uv.lock",
        "uv.toml",
      )

  ["v3-control-pytest"] {
    profiles = List("small")
    allow_binary = true
    allow_symlinks = true
    glob = implementation_inputs + contract_inputs + execution_inputs
    exclude = narrative_documents
    check =
      "python eng/scripts/hk_exec.py --timeout-seconds 720 uv run --python 3.13.12 --package three-workflow-delivery-v3 pytest -q src/public/lib/three-workflow-delivery-v3/tests"
  }
}

local workflow_delivery_v3_validation = new Mapping<String, Step> {
  ["static-reference-authority-preparation"] {
    profiles = List("small")
    check =
      "python eng/scripts/hk_exec.py --timeout-seconds 300 mise run prepare:static-reference-authorities"
  }

  ["v3-impact-validation"] {
    profiles = List("small")
    allow_binary = true
    allow_symlinks = true
    depends = List("static-reference-authority-preparation")
    stdin = "{% for file in files_list %}{{file}}\u{0}{% endfor %}"
    check = "python eng/scripts/workflow_delivery_v3_hk.py --dispatch-impact --hook {{hook}}"
  }

  ["node-mise-authority"] {
    profiles = List("small")
    glob =
      List(
        ".github/workflows/ci.yml",
        "eng/scripts/update_node_mise_lock.py",
        "mise.lock",
        "mise.toml",
      )
    check =
      "python eng/scripts/hk_exec.py --timeout-seconds 120 uv run --no-project --python 3.13 python eng/scripts/update_node_mise_lock.py"
  }

  ["hcoona-release-smoke-npm-static-reference"] {
    profiles = List("small")
    depends = List("static-reference-authority-preparation")
    check =
      "python eng/scripts/hk_exec.py --timeout-seconds 300 uv run --python 3.13 --package three-workflow-delivery-v3 python eng/scripts/workflow_delivery_v3_static_reference.py --repository-root . --source-kind index"
  }
}

local scholarly_publication_validation = new Mapping<String, Step> {
  local scholarly_publication_files =
    List(
      ".agents/skills/scholarly-pdf-reconstruction",
      ".agents/skills/scholarly-pdf-reconstruction/**",
      ".agents/skills/scholarly-print-assembly",
      ".agents/skills/scholarly-print-assembly/**",
      ".agents/skills/scholarly-render-qa",
      ".agents/skills/scholarly-render-qa/**",
      "apm.lock.yaml",
      "apm.yml",
      "mise.toml",
      "pyproject.toml",
      "src/private/lib/scholarly-publication/**",
    )

  ["scholarly-publication-plugin-ci"] {
    glob = scholarly_publication_files
    allow_symlinks = true
    check =
      "python eng/scripts/hk_exec.py --timeout-seconds 720 mise run scholarly-publication-plugin-ci"
  }
}

local dotenv_linter = new Mapping<String, Step> {
  ["dotenv-linter"] = (Steps.dotenv_linter) {
    profiles = List("small")
    check = "python eng/scripts/hk_exec.py dotenv-linter check -- {{files}}"
    fix = "python eng/scripts/hk_exec.py dotenv-linter fix --no-backup -- {{files}}"
  }
}

local ci = read?("prop:CI")?.toBoolean() ?? false
local function getTestPklEvalSyncCommand(
  source: String,
  target: String,
  format: String,
  properties: List<String>,
): String =
  (
    List(
      "pwsh",
      "-NoLogo",
      "-NoProfile",
      if (ci) "-NonInteractive" else "",
      "-File",
      "eng/linter/Test-PklEvalSync.ps1",
      "-Source",
      source,
      "-Target",
      target,
      "-Format",
      format,
      if (properties.isEmpty) "" else "-Properties " + properties.join(","),
    )
  ).join(" ")

local code_generation_guard = new Mapping<String, Step> {
  ["global-json"] {
    local file_list =
      List(
        "global.pkl",
        "global.json",
        "mise.lock",
      )
    profiles = List("small")
    glob = file_list
    stage = file_list
    check =
      getTestPklEvalSyncCommand(
        "global.pkl",
        "global.json",
        "json",
        List(),
      )
    fix = "pkl eval -f json global.pkl -o global.json"
  }
}

local commit_message_linters = new Mapping<String, Step> {
  ["commitlint"] = Steps.commitlint
}

local file_steps = new Mapping<String, Step> {
  ...general_linters
  ...pipeline_linters
  ...markdown_linters
  ...pkl_linters
  ...json_linters
  ...yaml_linters
  ...toml_linters
  ...docker_linters
  ...bash_linters
  ...pwsh_linters
  // ...dotnet_linters
  ...javascript_typescript_linters
  ...python_linters
  ...dotenv_linter
}

local all_steps = new Mapping<String, Step> {
  // HK selects against complete history; file readers need extant operands.
  // Scope this behavior to these steps so product-test subprocesses do not inherit it.
  for (name, step in file_steps) {
    [name] = (step) {
      env {
        ["HK_SKIP_MISSING_FILES"] = "1"
      }
    }
  }
  ...workflow_delivery_v3_validation
  ...scholarly_publication_validation
  ...code_generation_guard
  ["uv-lock"] = (Steps.uv_lock) {
    profiles = List("small")
  }
}

hooks = new {
  // Internal selection only: preparation belongs to the outer hook.
  ["impact-check"] {
    fix = false
    steps = workflow_delivery_v3_impact
  }

  ["pre-commit"] {
    fix = false
    stash = "git"
    steps = all_steps
  }

  ["commit-msg"] {
    steps = commit_message_linters
  }

  ["check"] {
    fix = false
    steps = all_steps
  }

  ["fix"] {
    fix = true
    steps = all_steps
  }
}
