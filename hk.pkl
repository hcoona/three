amends "src/private/lib/hk/Config.pkl"

import "src/private/lib/hk/Steps.pkl"

min_hk_version = "2.13.0"
display_skip_reasons =
  List(
    "profile-not-enabled",
    "profile-explicitly-disabled",
    "no-command-for-run-type",
    "no-files-to-process",
    "condition-false",
    "disabled-by-env",
    "disabled-by-cli",
  )
warnings = List("missing-profiles")

local apm_generated_output_list =
  List(
    ".agents/**",
    ".vscode/mcp.json",
    "apm.lock.yaml",
    "**/apm.lock.yaml",
  )

local general_exclude_list =
  List(
    "**/packages.lock.json",
    "global.json",
    "project.assets.json",
    "package-lock.json",
    "PklProject.deps.json",
    "pnpm-lock.yaml",
    "**/pnpm-lock.yaml",
    "uv.lock",
    "mise.lock",
    "**/mise.lock",
    "**/.github/**",
    "**/.specify/**",
    "**/specs/**/*.md",
    "**/generated/**",
  ) + apm_generated_output_list

local general_linters = new Mapping<String, Step> {
  ["typos"] = (Steps.typos) {
    profiles = List("small")
    exclude = general_exclude_list
  }

  ["editorconfig-check"] = (Steps.editorconfig_check) {
    profiles = List("medium")
    exclude = general_exclude_list
    check = new Command {
      argv = List("editorconfig-checker", "--disable-indent-size", "--", "{{files}}")
    }
  }
}

local pipeline_linters = new Mapping<String, Step> {
  ["actionlint"] {
    profiles = List("small")
    glob = List("**/.github/workflows/*.yml", "**/.github/workflows/*.yaml")
    check = new Command {
      // actionlint v1.7.11 predates GitHub Actions' concurrency.queue property.
      argv =
        List(
          "actionlint",
          "-ignore",
          "^unexpected key \"queue\" for \"concurrency\" section\\. expected one of \"cancel-in-progress\", \"group\"$",
          "--",
          "{{files}}",
        )
    }
  }
}

local markdown_linters = new Mapping<String, Step> {
  local markdown_append_only_artifact_exclude = List(".testagent/**")

  ["markdownlint-cli2"] = (Steps.markdownlint_cli2) {
    profiles = List("small")
    exclude = general_exclude_list + markdown_append_only_artifact_exclude
  }

  ["markdown-prettier"] {
    profiles = List("small")
    exclude = general_exclude_list + markdown_append_only_artifact_exclude
    glob = List("*.md")
    stage = List("*.md")
    check = new Command {
      argv = List("./node_modules/.bin/prettier", "--check", "--", "{{files}}")
    }
    fix = new Command {
      argv = List("./node_modules/.bin/prettier", "--write", "--", "{{files}}")
    }
  }
}

local pkl_linters = new Mapping<String, Step> {
  ["pkl-eval"] = (Steps.pkl_eval) {
    profiles = List("small")
  }

  ["pkl-format"] = (Steps.pkl_format) {
    profiles = List("small")
  }
}

local json_linters = new Mapping<String, Step> {
  ["json-biome"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("*.json", "*.jsonc")
    stage = List("*.json", "*.jsonc")
    check = new Command {
      argv =
        List(
          "./node_modules/.bin/biome",
          "check",
          "--no-errors-on-unmatched",
          "--",
          "{{files}}",
        )
    }
    fix = new Command {
      argv =
        List(
          "./node_modules/.bin/biome",
          "check",
          "--write",
          "--no-errors-on-unmatched",
          "--",
          "{{files}}",
        )
    }
  }
}

local yaml_linters = new Mapping<String, Step> {
  ["yaml-prettier"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("*.yml", "*.yaml")
    stage = List("*.yml", "*.yaml")
    check = new Command {
      argv = List("./node_modules/.bin/prettier", "--check", "--", "{{files}}")
    }
    fix = new Command {
      argv = List("./node_modules/.bin/prettier", "--write", "--", "{{files}}")
    }
  }
}

local toml_linters = new Mapping<String, Step> {
  ["toml-taplo-check"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("**/*.toml")
    check = new Command {
      argv = List("taplo", "check", "--", "{{files}}")
    }
  }

  ["toml-taplo-format"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("**/*.toml")
    stage = List("<JOB_FILES>")
    check = new Command {
      argv = List("taplo", "format", "--check", "--", "{{files}}")
    }
    check_diff = new Command {
      argv = List("taplo", "format", "--check", "--diff", "--", "{{files}}")
    }
    fix = new Command {
      argv = List("taplo", "format", "--", "{{files}}")
    }
  }
}

local docker_linters = new Mapping<String, Step> {
  ["hadolint"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("Dockerfile", "*.Dockerfile", "Dockerfile.*")
    check = new Command {
      argv = List("hadolint", "--", "{{files}}")
    }
  }
}

local bash_linters = new Mapping<String, Step> {
  ["shellcheck"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("**/*.sh", "**/*.bash")
    check = new Command {
      argv = List("shellcheck", "--", "{{files}}")
    }
  }

  ["shfmt"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = List("**/*.sh", "**/*.bash", "**/*.mksh", "**/*.bats", "**/*.zsh")
    check = new Command {
      argv = List("shfmt", "-d", "--apply-ignore", "--", "{{files}}")
    }
    fix = new Command {
      argv = List("shfmt", "-w", "--apply-ignore", "--", "{{files}}")
    }
  }
}

local pwsh_linters = new Mapping<String, Step> {
  local powershell_files = List("*.ps1", "*.psm1", "*.psd1")

  ["pwsh-formatter"] {
    profiles = List("medium")
    exclude = general_exclude_list
    batch = true
    glob = powershell_files
    stage = powershell_files
    check = new Command {
      argv =
        List(
          "pwsh",
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-File",
          "eng/linter/Invoke-FormatterWrapper.ps1",
          "-Mode",
          "Check",
          "-Path",
          "{{files}}",
        )
    }
    fix = new Command {
      argv =
        List(
          "pwsh",
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-File",
          "eng/linter/Invoke-FormatterWrapper.ps1",
          "-Mode",
          "Fix",
          "-Path",
          "{{files}}",
        )
    }
  }

  ["pwsh-script-analyzer"] {
    profiles = List("medium")
    exclude = general_exclude_list
    batch = true
    glob = powershell_files
    stage = powershell_files
    check = new Command {
      argv =
        List(
          "pwsh",
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-File",
          "eng/linter/Invoke-ScriptAnalyzerWrapper.ps1",
          "-Mode",
          "Check",
          "-Path",
          "{{files}}",
        )
    }
    fix = new Command {
      argv =
        List(
          "pwsh",
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-File",
          "eng/linter/Invoke-ScriptAnalyzerWrapper.ps1",
          "-Mode",
          "Fix",
          "-Path",
          "{{files}}",
        )
    }
  }
}

local dotnet_linters = new Mapping<String, Step> {
  local csharp_files = List("*.cs")

  // `dotnet format whitespace` applies the EditorConfig formatting rules. Folder mode needs no
  // project workspace (`dotnet format` cannot load the dirs.proj traversal project); `dotnet
  // build` already enforces style and analyzer diagnostics (EnforceCodeStyleInBuild).
  ["dotnet-format"] {
    profiles = List("medium")
    exclude = general_exclude_list
    batch = true
    glob = csharp_files
    stage = csharp_files
    check = new Command {
      argv =
        List(
          "dotnet",
          "format",
          "whitespace",
          "--folder",
          "--verify-no-changes",
          "--include",
          "{{files}}",
        )
    }
    fix = new Command {
      argv = List("dotnet", "format", "whitespace", "--folder", "--include", "{{files}}")
    }
  }

  ["dotnet-lock-verify"] = (Steps.dotnet_lock_verify) {
    profiles = List("medium")
    // Name the traversal project; `mise run slngen` adds main.sln to the repository root.
    check = new Command {
      argv = List("dotnet", "restore", "dirs.proj", "--locked-mode")
    }
    fix = new Command {
      argv = List("dotnet", "restore", "dirs.proj", "--force-evaluate")
    }
  }
}

local javascript_typescript_linters = new Mapping<String, Step> {
  local javascript_files = List("*.js", "*.cjs", "*.mjs", "*.jsx")
  local typescript_files = List("*.ts", "*.cts", "*.mts", "*.tsx")
  local javascript_typescript_files = javascript_files + typescript_files

  ["biome"] {
    profiles = List("small")
    exclude = general_exclude_list
    glob = javascript_typescript_files
    stage = javascript_typescript_files
    check = new Command {
      argv =
        List(
          "./node_modules/.bin/biome",
          "check",
          "--no-errors-on-unmatched",
          "--",
          "{{files}}",
        )
    }
    fix = new Command {
      argv =
        List(
          "./node_modules/.bin/biome",
          "check",
          "--write",
          "--no-errors-on-unmatched",
          "--",
          "{{files}}",
        )
    }
  }
}

local python_linters = new Mapping<String, Step> {
  local python_files = List("*.py", "*.pyi")
  local python_notebook_files = List("*.ipynb")
  local all_python_files = python_files + python_notebook_files
  local python_exclude_list =
    general_exclude_list + List("src/private/lib/scan-restoration/skills/**")

  ["ruff"] {
    profiles = List("small")
    exclude = python_exclude_list
    glob = all_python_files
    stage = all_python_files
    check = new Command {
      argv = List("uv", "run", "ruff", "check", "--force-exclude", "--", "{{files}}")
    }
    fix = new Command {
      argv = List("uv", "run", "ruff", "check", "--force-exclude", "--fix", "--", "{{files}}")
    }
  }

  ["ruff_format"] {
    profiles = List("small")
    exclude = python_exclude_list
    glob = all_python_files
    stage = all_python_files
    check = new Command {
      argv =
        List(
          "uv",
          "run",
          "ruff",
          "format",
          "--quiet",
          "--force-exclude",
          "--check",
          "--",
          "{{files}}",
        )
    }
    check_diff = new Command {
      argv =
        List(
          "uv",
          "run",
          "ruff",
          "format",
          "--quiet",
          "--force-exclude",
          "--diff",
          "--",
          "{{files}}",
        )
    }
    fix = new Command {
      argv = List("uv", "run", "ruff", "format", "--quiet", "--force-exclude", "--", "{{files}}")
    }
  }
}

local workflow_delivery_v3_validation = new Mapping<String, Step> {
  ["python-mise-authority"] {
    profiles = List("small")
    glob =
      List(
        "mise.toml",
        "mise.lock",
        ".python-version",
        ".config/uv/uv.toml",
        "eng/scripts/sync_python_version.py",
      )
    check = new Command {
      argv = List("python", "eng/scripts/sync_python_version.py")
    }
  }
  // CiScope's fixed copies of HK step globs and exclusions stay aligned with this file.
  ["hk-scope-drift"] {
    profiles = List("small")
    glob =
      List(
        "hk.pkl",
        "src/private/lib/hk/**",
        "src/private/app/workflow-delivery/Repository/resources/hk-scope-copies.json",
        ".github/workflows/ci.yml",
        "eng/scripts/hk_scope_drift.py",
      )
    check = new Command {
      argv = List("python", "eng/scripts/hk_scope_drift.py")
    }
  }
  ["public-release-inventory"] {
    profiles = List("small")
    check = new Command {
      argv = List("uv", "run", "python", "eng/scripts/release_triage.py", "--check-inventory")
    }
  }
  ["markdown-links"] {
    profiles = List("small")
    check = new Command {
      argv = List("lychee", "--config", ".lychee.toml", "--no-progress", ".")
    }
  }
  ["records-check"] {
    profiles = List("small")
    check = new Command {
      argv = List("mise", "run", "records:check")
    }
  }
  ["supply-chain-policy"] {
    profiles = List("small")
    check = new Command {
      argv = List("uv", "run", "python", "eng/scripts/check_supply_chain_policy.py")
    }
  }
}

local scholarly_publication_validation = new Mapping<String, Step> {
  local scholarly_publication_files =
    List(
      ".agents/skills/scholarly-pdf-reconstruction",
      ".agents/skills/scholarly-pdf-reconstruction/**",
      ".agents/skills/scholarly-print-assembly",
      ".agents/skills/scholarly-print-assembly/**",
      ".agents/skills/scholarly-render-qa",
      ".agents/skills/scholarly-render-qa/**",
      "apm.lock.yaml",
      "apm.yml",
      "mise.toml",
      "pyproject.toml",
      "src/private/lib/scholarly-publication/**",
    )

  ["scholarly-publication-plugin-check"] {
    glob = scholarly_publication_files
    allow_symlinks = true
    check = new Command {
      argv = List("mise", "run", "scholarly-publication-plugin-check")
    }
  }
}

local dotenv_linter = new Mapping<String, Step> {
  ["dotenv-linter"] = (Steps.dotenv_linter) {
    profiles = List("small")
  }
}

local tla_linters = new Mapping<String, Step> {
  ["tla-sany"] {
    profiles = List("small")
    exclude = general_exclude_list
    batch = true
    glob = List("*.tla")
    check = new Command {
      argv =
        List(
          "python",
          "eng/scripts/tla.py",
          "sany",
          "--driver",
          "eng/linter/TlaSanyCheck.java",
          "--",
          "{{files}}",
        )
    }
  }
}

local commit_message_linters = new Mapping<String, Step> {
  ["commitlint"] = (Steps.commitlint) { check_first = true }
}

local file_steps = new Mapping<String, Step> {
  ...general_linters
  ...pipeline_linters
  ...markdown_linters
  ...pkl_linters
  ...json_linters
  ...yaml_linters
  ...toml_linters
  ...docker_linters
  ...bash_linters
  ...pwsh_linters
  ...dotnet_linters
  ...javascript_typescript_linters
  ...python_linters
  ...dotenv_linter
  ...tla_linters
}

local configured_steps = new Mapping<String, Step> {
  ...file_steps
  ...workflow_delivery_v3_validation
  ...scholarly_publication_validation
  ["uv-lock"] = (Steps.uv_lock) {
    profiles = List("small")
  }
}

// HK 2 defaults to fixing first; retain the established check-before-fix behavior.
local all_steps = (configured_steps) {
  for (name, step in configured_steps) {
    [name] { check_first = true }
  }
}

hooks = new {
  ["pre-commit"] {
    fix = false
    stash = "git"
    timeout = "12m"
    steps = all_steps
  }

  ["commit-msg"] {
    steps = commit_message_linters
  }

  ["check"] {
    fix = false
    timeout = "12m"
    steps = all_steps
  }

  ["fix"] {
    fix = true
    timeout = "12m"
    steps = all_steps
  }
}
