// Generate .pre-commit-config.yaml from hk.pkl configuration
//
// This Pkl module transforms hk step definitions into pre-commit format

import "hk.pkl"

// Convert glob pattern to regex
local function globToRegex(glob: String): String =
  let (altOpenPlaceholder = "<<<ALT_OPEN>>>")
  let (altClosePlaceholder = "<<<ALT_CLOSE>>>")
  let (altOrPlaceholder = "<<<ALT_OR>>>")
  let (
    // Handle brace expansion: *.{yml,yaml} -> \.(yml|yaml)$
    withBraces =
      if (glob.contains("{") && glob.contains("}"))
        let (start = glob.indexOf("{"))
        let (end = glob.indexOf("}"))
        let (braceContent = glob.substring(start + 1, end))
        let (alternatives = braceContent.split(",").join(altOrPlaceholder))
        let (before = glob.substring(0, start))
        let (after = glob.substring(end + 1, glob.length))
          before + altOpenPlaceholder + alternatives + altClosePlaceholder + after
      else
        glob
  )
  let (
    placeholderGlob =
      withBraces
        .replaceAll("**/", "<<<ANYDIR>>>")
        .replaceAll("**", "<<<ANYCHARS>>>")
        .replaceAll("*", "<<<DIRCHARS>>>")
        .replaceAll("?", "<<<SINGLECHAR>>>")
  )
  let (
    // Escape dots and convert wildcards, then restore placeholders
    escaped =
      placeholderGlob
        .replaceAll("\\", "\\\\")
        .replaceAll(".", "\\.")
        .replaceAll("+", "\\+")
        .replaceAll("(", "\\(")
        .replaceAll(")", "\\)")
        .replaceAll("{", "\\{")
        .replaceAll("}", "\\}")
        .replaceAll("[", "\\[")
        .replaceAll("]", "\\]")
        .replaceAll("^", "\\^")
        .replaceAll("$", "\\$")
        .replaceAll("|", "\\|")
  )
  let (
    regex =
      escaped
        .replaceAll("<<<ANYDIR>>>", "(?:.*/)*")
        .replaceAll("<<<ANYCHARS>>>", ".*")
        .replaceAll("<<<DIRCHARS>>>", "[^/]*")
        .replaceAll("<<<SINGLECHAR>>>", "[^/]")
        .replaceAll(altOpenPlaceholder, "(")
        .replaceAll(altClosePlaceholder, ")")
        .replaceAll(altOrPlaceholder, "|")
  )
    regex + "$"

// Convert exclude list to regex pattern
local function excludeListToRegex(excludeList: List): String =
  let (
    patterns =
      excludeList.map((patternAny) ->
        let (pattern = patternAny.toString())
        // Process glob patterns in correct order (before escaping special chars)
        // 1. Replace **/ with a placeholder that won't be escaped
        let (step1 = pattern.replaceAll("**/", "<<<ANYDIR>>>"))
        // 2. Replace remaining ** with another placeholder
        let (step2 = step1.replaceAll("**", "<<<ANYCHARS>>>"))
        // 3. Replace single * with another placeholder
        let (step3 = step2.replaceAll("*", "<<<DIRCHARS>>>"))
        // 4. Now escape dots
        let (step4 = step3.replaceAll(".", "\\."))
        // 5. Replace placeholders with actual regex
        let (step5 = step4.replaceAll("<<<ANYDIR>>>", ".*/"))
        let (step6 = step5.replaceAll("<<<ANYCHARS>>>", ".*"))
        let (step7 = step6.replaceAll("<<<DIRCHARS>>>", "[^/]*"))
          step7
      )
  )
    "(" + patterns.join("|") + ")"

// Normalize nullable values into a List for easier processing
local function normalizeList(value: Any?): List =
  if (value == null)
    List()
  else if (value is List)
    value
  else
    List(value)

// Convert hk step types to glob patterns
local function typeToGlobs(typeName: String): List =
  if (typeName == "pkl")
    List("*.pkl")
  else
    List()

// Convert a single step to pre-commit hook
//
// Key semantic mapping:
// - hk batch=true: run command multiple times in parallel with file batches
//   -> pre-commit pass_filenames=true: pass filenames as args
// - hk batch=false (default): run command once with all files
//   -> pre-commit pass_filenames=true if {{files}} in command, false otherwise
// - hk {{files}} template -> remove it, pre-commit handles file passing
// - hk {{commit_msg_file}} template -> map to PRE_COMMIT_COMMIT_MSG env fallback
local function stepToHook(hookName: String, id: String, step: Any): Dynamic? =
  let (stepDyn = (step as Typed).toDynamic())
  let (profiles = normalizeList(stepDyn.profiles))
  let (isGroup = stepDyn.getPropertyOrNull("steps") != null)
    if (
      !isGroup
        && (
          profiles.isEmpty
            || profiles.contains("small")
            || profiles.contains("medium")
        )
    )
      let (
        checkCmd =
          if (stepDyn.check is String)
            stepDyn.check
          else if (stepDyn.check != null && stepDyn.check.linux != null)
            stepDyn.check.linux
          else
            ""
      )
      let (prefix = if (stepDyn.prefix != null) stepDyn.prefix else "")
      let (hasFilesPlaceholder = checkCmd.contains("{{files}}") || checkCmd.contains("{{ files }}"))
      let (rawEntry = if (prefix != "") prefix + " " + checkCmd else checkCmd)
      let (commitMsgPlaceholder = "\"${PRE_COMMIT_COMMIT_MSG:-.git/COMMIT_EDITMSG}\"")
      // Remove {{files}} placeholders - pre-commit handles file passing
      let (
        entry =
          rawEntry
            .replaceAll("{{files}}", "")
            .replaceAll("{{ files }}", "")
            .replaceAll("{{commit_msg_file}}", commitMsgPlaceholder)
            .replaceAll("{{ commit_msg_file }}", commitMsgPlaceholder)
            .replaceAll(">/dev/null", "")
            .replaceAll("2>/dev/null", "")
            .replaceAll("2>&1", "")
            .replaceAll("  ", " ")
            .trim()
      )
      // Determine pass_filenames based on whether command expects files
      // Key rule: pass filenames when batch mode is enabled or {{files}} placeholder was used
      let (isBatch = stepDyn.batch == true)
      let (
        passFilenames =
          if (hookName == "commit-msg")
            false
          else
            isBatch || hasFilesPlaceholder
      )
      let (rawStagePatterns = normalizeList(stepDyn.stage))
      let (globPatterns = normalizeList(stepDyn.glob))
      let (typeNames = normalizeList(stepDyn.types))
      let (typeGlobs = typeNames.flatMap((t) -> typeToGlobs(t.toString())))
      let (
        stagePatterns =
          rawStagePatterns.flatMap((patternAny) ->
            let (pattern = patternAny.toString())
              if (pattern == "<JOB_FILES>")
                globPatterns
              else
                List(patternAny)
          )
      )
      let (
        typePattern =
          if (!typeGlobs.isEmpty)
            typeGlobs.map((g) -> globToRegex(g.toString())).join("|")
          else
            null
      )
      let (
        filePattern =
          if (!stagePatterns.isEmpty)
            stagePatterns.map((g) -> globToRegex(g.toString())).join("|")
          else if (!globPatterns.isEmpty)
            globPatterns.map((g) -> globToRegex(g.toString())).join("|")
          else if (typePattern != null)
            typePattern
          else
            null
      )
      let (excludePatterns = normalizeList(stepDyn.exclude))
        new Dynamic {
          ["id"] = id
          ["name"] = id.split("-").map((s) -> s.capitalize()).join(" ")
          ["entry"] = entry
          ["language"] = "system"
          ["pass_filenames"] = passFilenames
          when (filePattern != null) {
            ["files"] = filePattern
          }
          when (!excludePatterns.isEmpty) {
            ["exclude"] = excludeListToRegex(excludePatterns)
          }
          when (hookName == "commit-msg") {
            ["stages"] = List("commit-msg")
          }
        }
    else
      null

// Process steps from a group or single step
local function processItem(hookName: String, name: String, item: Any): List =
  let (itemDyn = (item as Typed).toDynamic())
  let (itemSteps = itemDyn.getPropertyOrNull("steps"))
    if (itemSteps != null)
      (itemSteps as Mapping).keys
        .toList()
        .flatMap((stepName) ->
          let (step = (itemSteps as Mapping)[stepName])
          let (hook = stepToHook(hookName, stepName, step))
            if (hook != null) List(hook) else List()
        )
    else
      let (hook = stepToHook(hookName, name, item))
        if (hook != null) List(hook) else List()

// Process all supported hooks
local hookNames = List("pre-commit", "commit-msg")

local allHooks: List =
  hookNames.flatMap((hookName) ->
    let (hook = hk.hooks[hookName])
      hook.steps.keys.toList().flatMap((name) -> processItem(hookName, name, hook.steps[name]))
  )

// Output pre-commit config
output {
  renderer = new YamlRenderer {}
  value = new {
    default_stages = List("pre-commit")
    fail_fast = false
    minimum_pre_commit_version = "3.0.0"
    repos = new Listing {
      new {
        repo = "local"
        hooks = allHooks
      }
    }
  }
}
