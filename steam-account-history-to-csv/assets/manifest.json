{
  "manifest_version": 3,
  "name": "Steam Account History to CSV",
  "version": "0.0.0",
  "description": "Convert Steam account history table into csv file for further edits in Excel",
  "action": {
    "default_title": "Steam Account History to CSV"
  },
  "icons": {
    "32": "icon-32.png",
    "48": "icon-48.png"
  },
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/account/history/"],
      "js": ["index.js"],
      "run_at": "document_idle"
    }
  ]
}
