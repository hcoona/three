<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);docs/**;README.md</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WorkflowDelivery.Tests" />
    <EmbeddedResource Include="Repository/resources/hk-scope-copies.json" LogicalName="HkScopeCopies" />
    <EmbeddedResource Include="../../../../src/public/**/workflow-delivery.release-unit.yml"
                      LogicalName="ReleaseUnit:src/public/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../../tests/private/app/workflow-delivery/fixtures/products/**/workflow-delivery.release-unit.yml"
                      LogicalName="ReleaseUnit:tests/private/app/workflow-delivery/fixtures/products/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../../src/public/lib/*/*.csproj;../../../../src/public/lib/*/package.json"
                      Exclude="../../../../src/public/lib/*.Generators/*.csproj;../../../../src/public/lib/steam-account-history-to-csv/package.json"
                      LogicalName="ReleaseManifest:$([System.IO.Path]::GetRelativePath('$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../..'))', '%(FullPath)').Replace('\', '/'))" />
    <EmbeddedResource Include="../../../../tests/private/app/workflow-delivery/fixtures/products/*/*.csproj;../../../../tests/private/app/workflow-delivery/fixtures/products/*/package.json"
                      LogicalName="ReleaseManifest:$([System.IO.Path]::GetRelativePath('$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../..'))', '%(FullPath)').Replace('\', '/'))" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Build" />
    <PackageReference Include="Microsoft.Build.Framework" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="NuGet.ProjectModel" />
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Commands" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="NuGet.Frameworks" />
  </ItemGroup>
  <Target Name="ReferenceOfficialNbgv" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(NerdbankGitVersioningTasksPath)' == ''" Text="The official NBGV task path is unavailable." />
    <ItemGroup>
      <Reference Include="Nerdbank.GitVersioning">
        <HintPath>$(NerdbankGitVersioningTasksPath)Nerdbank.GitVersioning.dll</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
