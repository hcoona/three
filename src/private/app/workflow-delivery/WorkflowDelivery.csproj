<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;Engine/**;Ecosystems/DotNet/**;Ecosystems/Node/**;Ecosystems/Python/**;Ecosystems/Ruby/**;Platform/**;docs/**;README.md</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);Repository/GitReader.cs;Repository/GitMaterialization.cs;Repository/DotNetGraph.cs;Repository/DotNetConfigurationInputs.cs;Repository/DotNetNativeInputs.cs;Repository/DotNetRepositoryReader.cs;Repository/MsBuildResourceReader.cs;Repository/NbgvInputReader.cs;CI/DotNetBuildTask.cs;CI/DotNetTestTask.cs;Ecosystems/DotNetPackage*.cs</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);Repository/Pnpm*Reader.cs;Ecosystems/AdoptedNpmPackage.cs;Ecosystems/NodePackageArchive.cs;Ecosystems/NpmPackageOperations.cs;Ecosystems/BrowserExtensionArchive.cs</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);Repository/PythonNativeGraphReader.cs;Repository/PythonDependencyProjection.cs;Repository/PythonMetadataReader.cs;Repository/PythonPassiveReader.cs;Repository/PythonPytestConfigurationReader.cs;Ecosystems/PythonPackageOperations.cs</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);Repository/RubyNativeFactCollector.cs;Repository/RubyNativeFactsReader.cs;Repository/RubyDependencyProjection.cs;Ecosystems/RubyPackageOperations.cs</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Core/WorkflowDelivery.Core.csproj" />
    <ProjectReference Include="Engine/WorkflowDelivery.Engine.csproj" />
    <ProjectReference Include="Ecosystems/DotNet/WorkflowDelivery.DotNet.csproj;Ecosystems/Node/WorkflowDelivery.Node.csproj;Ecosystems/Python/WorkflowDelivery.Python.csproj;Ecosystems/Ruby/WorkflowDelivery.Ruby.csproj;Platform/WorkflowDelivery.NativePlatform.csproj" />
    <Compile Include="Platform/GitHubComparison.cs;Platform/RunnerLog.cs" />
    <InternalsVisibleTo Include="WorkflowDelivery.Tests" />
    <EmbeddedResource Include="Repository/resources/hk-scope-copies.json" LogicalName="HkScopeCopies" />
    <EmbeddedResource Include="../../../../src/public/**/workflow-delivery.release-unit.yml"
                      LogicalName="ReleaseUnit:src/public/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../../tests/private/app/workflow-delivery/fixtures/products/**/workflow-delivery.release-unit.yml"
                      LogicalName="ReleaseUnit:tests/private/app/workflow-delivery/fixtures/products/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../../src/public/**/*.csproj;../../../../src/public/**/package.json"
                      Exclude="../../../../src/public/**/*.Generators/**;../../../../src/public/app/ImageOcclusionEditor/**;../../../../src/public/lib/steam-account-history-to-csv/package.json;../../../../src/public/**/examples/**;../../../../src/public/**/test*/**;../../../../src/public/**/node_modules/**;../../../../src/public/**/bin/**;../../../../src/public/**/obj/**"
                      LogicalName="ReleaseManifest:src/public/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../../tests/private/app/workflow-delivery/fixtures/products/**/*.csproj;../../../../tests/private/app/workflow-delivery/fixtures/products/**/package.json"
                      Exclude="../../../../tests/private/app/workflow-delivery/fixtures/products/**/examples/**;../../../../tests/private/app/workflow-delivery/fixtures/products/**/test*/**;../../../../tests/private/app/workflow-delivery/fixtures/products/**/node_modules/**;../../../../tests/private/app/workflow-delivery/fixtures/products/**/bin/**;../../../../tests/private/app/workflow-delivery/fixtures/products/**/obj/**"
                      LogicalName="ReleaseManifest:tests/private/app/workflow-delivery/fixtures/products/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Versioning" />
  </ItemGroup>
</Project>
