<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);docs/**;README.md</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WorkflowDelivery.Tests" />
    <EmbeddedResource Include="Repository/resources/hk-scope-copies.json" LogicalName="HkScopeCopies" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <Reference Include="Microsoft.Build" HintPath="$(MSBuildBinPath)/Microsoft.Build.dll" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)/Microsoft.Build.Framework.dll" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)/Microsoft.Build.Utilities.Core.dll" />
    <PackageReference Include="NuGet.ProjectModel" />
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Commands" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="NuGet.Frameworks" />
  </ItemGroup>
  <Target Name="ReferenceOfficialNbgv" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(NerdbankGitVersioningTasksPath)' == ''" Text="The official NBGV task path is unavailable." />
    <ItemGroup>
      <Reference Include="Nerdbank.GitVersioning">
        <HintPath>$(NerdbankGitVersioningTasksPath)Nerdbank.GitVersioning.dll</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
