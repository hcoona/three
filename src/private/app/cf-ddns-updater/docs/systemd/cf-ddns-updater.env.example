# Copy this file to /etc/cf-ddns-updater/cf-ddns-updater.env and edit the values.

HCOONA_CLOUDFLARE_DDNS_UPDATER_API_TOKEN=replace-with-cloudflare-api-token
HCOONA_CLOUDFLARE_DDNS_UPDATER_DOMAINS=example.com,host.example.com

# Optional; defaults to false if omitted.
# HCOONA_CLOUDFLARE_DDNS_UPDATER_DISABLE_IPV6=false
