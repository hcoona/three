{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcoona:three:celesphonia-modifier:atlas-v0:copy-receipt:v1",
  "title": "Atlas V0 Copy Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surveyAlias",
    "receiptArtifactAlias",
    "profile",
    "copyRequestSha256",
    "approvedStateSha256",
    "approvedManifestSha256",
    "sourceRootMapSha256",
    "copyPlanSha256",
    "decisionReference",
    "approvedManifestArtifactAlias",
    "finalCopyRootRelativePath",
    "steamAppId",
    "buildId",
    "gameExecutableSha256",
    "saveCount",
    "definitionCount",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "atlas-copy-receipt/v1"
    },
    "surveyAlias": {
      "$ref": "#/$defs/surveyAlias"
    },
    "receiptArtifactAlias": {
      "$ref": "#/$defs/artifactAlias"
    },
    "profile": {
      "const": "trusted-local-filesystem/v1"
    },
    "copyRequestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "approvedStateSha256": {
      "$ref": "#/$defs/sha256"
    },
    "approvedManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceRootMapSha256": {
      "$ref": "#/$defs/sha256"
    },
    "copyPlanSha256": {
      "$ref": "#/$defs/sha256"
    },
    "decisionReference": {
      "type": "string",
      "pattern": "^commit:[0-9a-f]{40}$"
    },
    "approvedManifestArtifactAlias": {
      "$ref": "#/$defs/artifactAlias"
    },
    "finalCopyRootRelativePath": {
      "const": "copies/snapshot-a2-000001"
    },
    "steamAppId": {
      "const": 1786790
    },
    "buildId": {
      "const": 13624401
    },
    "gameExecutableSha256": {
      "$ref": "#/$defs/sha256"
    },
    "saveCount": {
      "type": "integer",
      "minimum": 0
    },
    "definitionCount": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "surveyAlias": {
      "type": "string",
      "pattern": "^survey-[a-z0-9-]+$"
    },
    "artifactAlias": {
      "type": "string",
      "pattern": "^private-artifact-[0-9]{6}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonicalRelativePath": {
      "type": "string",
      "pattern": "^(?![/.])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?:[^:/\\\\]+/)*[^:/\\\\]+$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destinationArtifactAlias",
        "sourceAlias",
        "artifactClass",
        "destinationRelativePath",
        "sourceLength",
        "sourceLastWriteTimeUtc",
        "sourceSha256"
      ],
      "properties": {
        "destinationArtifactAlias": {
          "$ref": "#/$defs/artifactAlias"
        },
        "sourceAlias": {
          "type": "string",
          "pattern": "^(save-source-[0-9]{4}|definition-source-[0-9]{6})$"
        },
        "artifactClass": {
          "enum": ["save-copy", "definition-copy"]
        },
        "destinationRelativePath": {
          "$ref": "#/$defs/canonicalRelativePath"
        },
        "sourceLength": {
          "type": "integer",
          "minimum": 0
        },
        "sourceLastWriteTimeUtc": {
          "type": "string",
          "format": "date-time"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
