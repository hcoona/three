{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcoona:three:celesphonia-modifier:atlas-v0:copy-plan:v1",
  "title": "Atlas V0 Copy Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surveyAlias", "manifestRevision", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "atlas-copy-plan/v1"
    },
    "surveyAlias": {
      "$ref": "#/$defs/surveyAlias"
    },
    "manifestRevision": {
      "const": 4
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "surveyAlias": {
      "type": "string",
      "pattern": "^survey-[a-z0-9-]+$"
    },
    "artifactAlias": {
      "type": "string",
      "pattern": "^private-artifact-[0-9]{6}$"
    },
    "canonicalRelativePath": {
      "type": "string",
      "pattern": "^(?![/.])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?:[^:/\\\\]+/)*[^:/\\\\]+$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceAlias", "destinationArtifactAlias", "artifactClass", "destinationRelativePath"],
      "properties": {
        "sourceAlias": {
          "type": "string",
          "pattern": "^(save-source-[0-9]{4}|definition-source-[0-9]{6})$"
        },
        "destinationArtifactAlias": {
          "$ref": "#/$defs/artifactAlias"
        },
        "artifactClass": {
          "enum": ["save-copy", "definition-copy"]
        },
        "destinationRelativePath": {
          "$ref": "#/$defs/canonicalRelativePath"
        }
      }
    }
  }
}
