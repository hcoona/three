<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Microsoft.Build.Artifacts" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>Hcoona.VsCodeCopilotTelegramHook</AssemblyName>
    <RootNamespace>Hcoona.VsCodeCopilotTelegramHook</RootNamespace>
    <TargetName>vscode-copilot-telegram-hook</TargetName>

    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hcoona.VsCodeCopilotTelegramHook.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="instructions/copilot-notify-summary.instructions.md">
      <LogicalName>CopilotNotifySummaryInstruction</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
