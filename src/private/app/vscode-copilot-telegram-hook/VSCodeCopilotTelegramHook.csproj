<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Microsoft.Build.Artifacts" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>

    <AssemblyName>vscode-copilot-telegram-hook</AssemblyName>
    <RootNamespace>Hcoona.VsCodeCopilotTelegramHook</RootNamespace>

    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hcoona.VsCodeCopilotTelegramHook.Tests" />
  </ItemGroup>
</Project>
