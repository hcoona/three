import "../Config.pkl"

local GlobList =
  List(
    ".env",
    "*.env",
    ".env.*",
    "**/.env",
    "**/*.env",
    "**/.env.*",
  )

dotenv_linter = new Config.Step {
  batch = true
  glob = GlobList
  stage = GlobList
  check = new Config.Command {
    argv = List("dotenv-linter", "check", "--", "{{files}}")
  }
  fix = new Config.Command {
    argv = List("dotenv-linter", "fix", "--no-backup", "--", "{{files}}")
  }
}
