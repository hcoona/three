import "../Config.pkl"

typos = new Config.Step {
  batch = true
  check = new Config.Command {
    argv = List("typos", "-c", ".typos.toml", "--force-exclude", "--", "{{files}}")
  }
  fix = new Config.Command {
    argv = List("typos", "-c", ".typos.toml", "--force-exclude", "-w", "--", "{{files}}")
  }
}
