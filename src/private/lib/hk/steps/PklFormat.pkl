import "../Config.pkl"

pkl_format = new Config.Step {
  batch = true
  check = new Config.Command {
    argv = List("pkl", "format", "--silent", "--", "{{files}}")
  }
  fix = new Config.Command {
    argv = List("pkl", "format", "--silent", "--write", "--", "{{files}}")
  }
  glob = List("*.pkl")
  stage = List("*.pkl")
}
