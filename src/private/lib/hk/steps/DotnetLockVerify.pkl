import "../Config.pkl"

local GlobList =
  List(
    "*.csproj",
    "*.props",
    "*.targets",
    "global.json",
    "nuget.config",
    "packages.lock.json",
  )

dotnet_lock_verify = new Config.Step {
  // The commands restore the whole repository and take no {{files}}; batching would run
  // concurrent whole-repository restores that write the same lock files.
  batch = false
  glob = GlobList
  stage = GlobList
  check = new Config.Command {
    argv = List("dotnet", "restore", "--locked-mode")
  }
  fix = new Config.Command {
    argv = List("dotnet", "restore", "--force-evaluate")
  }
}
