import "../Config.pkl"

uv_lock = new Config.Step {
  batch = false
  glob = List("**/pyproject.toml", "uv.lock")
  stage = List("**/pyproject.toml", "uv.lock")
  check = new Config.Command {
    argv = List("uv", "lock", "--check")
  }
  fix = new Config.Command {
    argv = List("uv", "lock")
  }
}
