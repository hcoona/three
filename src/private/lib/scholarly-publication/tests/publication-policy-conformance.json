    },
    {
      "id": "numeric-spacing-conflict",
      "accepted": false,
      "content": "p { font-variant-numeric: proportional-nums tabular-nums; }"
    },
    {
      "id": "east-asian-variant-conflict",
      "accepted": false,
      "content": "p { font-variant-east-asian: jis78 jis90; }"
    },
    {
      "id": "east-asian-width-conflict",
      "accepted": false,
      "content": "p { font-variant-east-asian: full-width proportional-width; }"
    },
    {
      "id": "function-value",
      "accepted": false,
      "content": "p { font-size: calc(1em + 1px); }"
    },
    {
      "id": "visibility-suppression",
      "accepted": false,
      "content": "p { display: none; }"
    }
  ]
