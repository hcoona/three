      "accepted": true,
      "operation": "remove",
      "path": ["untrusted_stylesheet", "properties"],
      "value": "color"
    },
    {
      "id": "remove-selector-surface",
      "accepted": true,
      "operation": "remove",
      "path": ["untrusted_stylesheet", "selector_surface"],
      "value": "id"
    },
    {
