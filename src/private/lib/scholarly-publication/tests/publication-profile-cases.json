      "accepted": false,
      "operation": "append",
      "path": ["fragment_html", "elements", "p"],
      "value": "href"
    },
    {
      "id": "add-global-attribute",
      "accepted": false,
      "operation": "append",
      "path": ["fragment_html", "global_attributes"],
      "value": "data-extra"
    },
    {
      "id": "add-unsupported-css-property",
      "accepted": false,
      "operation": "append",
      "path": ["untrusted_stylesheet", "properties"],
      "value": "display"
    },
    {
      "id": "add-css-custom-property",
      "accepted": false,
