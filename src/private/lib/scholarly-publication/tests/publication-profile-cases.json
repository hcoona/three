  "mutations": [
    {
      "id": "remove-element",
      "accepted": true,
      "operation": "delete",
      "path": ["fragment_html", "elements", "abbr"]
    },
    {
      "id": "remove-local-attribute",
      "accepted": true,
      "operation": "remove",
      "path": ["fragment_html", "elements", "a"],
      "value": "href"
    },
    {
