{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcoona.github.io/schemas/scholarly-publication/section-map-1.0.json",
  "title": "Scholarly publication section map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sections"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "start_pdf_page", "end_pdf_page"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "start_pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "end_pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "printed_folio_start": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
