{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcoona.github.io/schemas/scholarly-publication/translation-bundle-1.0.json",
  "title": "Scholarly publication translation bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_package",
    "target_language",
    "fragment_text_normalization",
    "approval",
    "fragments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_package": {
      "$ref": "#/$defs/asset"
    },
    "target_language": {
      "$ref": "#/$defs/language"
    },
    "fragment_text_normalization": {
      "const": "approved-fragment-visible-text-v1"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "const": "approved"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "bytes", "visible_text_sha256", "source_block_ids"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "visible_text_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "source_block_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^pdf-[0-9]{4,}-block-[0-9]{4,}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "\\\\"
          },
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          {
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
          }
        ]
      }
    }
  }
}
