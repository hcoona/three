<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <GitVersionBaseDirectory Condition="Exists('$(MSBuildProjectDirectory)/version.json')">$(MSBuildProjectDirectory)</GitVersionBaseDirectory>
  </PropertyGroup>
</Project>
