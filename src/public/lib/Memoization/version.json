{
  "$schema": "https://raw.githubusercontent.com/AArnott/Nerdbank.GitVersioning/master/src/NerdBank.GitVersioning/version.schema.json",
  "version": "1.3.0-beta.{height}",
  "pathFilters": [".", "../../../../OneDotNet/srcs/private/lib/Memoization.Generators"],
  "publicReleaseRefSpec": ["^refs/heads/main$", "^refs/heads/release/Memoization/v\\d+\\.\\d+\\.x$"],
  "release": {
    "tagName": "release/Memoization/v{version}",
    "firstUnstableTag": "beta"
  },
  "inherit": true
}
