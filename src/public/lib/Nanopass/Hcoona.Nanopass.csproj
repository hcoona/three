<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>Hcoona.Nanopass</PackageId>
    <AssemblyName>Hcoona.Nanopass</AssemblyName>
    <RootNamespace>Hcoona.Nanopass</RootNamespace>
    <PackageDescription>Strongly typed Nanopass intermediate-representation grammar framework for C# 15 and .NET 11 with incremental language definitions, C# 15 union code generation, and S-expression tooling.</PackageDescription>
    <PackageTags>compiler nanopass ir ast csharp15 union source-generator roslyn</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackNanopassGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="SetPackageReleaseNotes" BeforeTargets="GenerateNuspec">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)/ReleaseNotes.md">
      <Output TaskParameter="Lines" ItemName="ReleaseNotesLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <PackageReleaseNotes>@(ReleaseNotesLines, '%0A')</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="ReleaseNotes.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Nanopass.Generators/Hcoona.Nanopass.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackNanopassGenerator" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_NanopassGenerator Include="@(Analyzer->WithMetadataValue('Filename', 'Hcoona.Nanopass.Generators'))" />
      <TfmSpecificPackageFile Include="@(_NanopassGenerator)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
    <Error Condition="'@(_NanopassGenerator)' == ''" Text="The Nanopass generator was not resolved for packaging." />
  </Target>

</Project>
