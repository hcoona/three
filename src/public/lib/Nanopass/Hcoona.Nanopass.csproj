<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>Hcoona.Nanopass</PackageId>
    <AssemblyName>Hcoona.Nanopass</AssemblyName>
    <RootNamespace>Hcoona.Nanopass</RootNamespace>
    <PackageDescription>Strongly typed Nanopass intermediate-representation grammar framework for C# 15 and .NET 11 with incremental language definitions, C# 15 union code generation, and S-expression tooling.</PackageDescription>
    <PackageTags>compiler nanopass ir ast csharp15 union source-generator roslyn</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/ReleaseNotes.md'))</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="ReleaseNotes.md" />
    <None Include="$(MSBuildProjectDirectory)/../Nanopass.Generators/bin/$(Configuration)/netstandard2.0/Hcoona.Nanopass.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Nanopass.Generators/Hcoona.Nanopass.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
