{
  "$schema": "https://raw.githubusercontent.com/AArnott/Nerdbank.GitVersioning/master/src/NerdBank.GitVersioning/version.schema.json",
  "version": "0.1.0-beta.{height}",
  "pathFilters": [".", "../Nanopass.Generators"],
  "publicReleaseRefSpec": ["^refs/heads/main$", "^refs/heads/release/Nanopass/v\\d+\\.\\d+\\.x$"],
  "release": {
    "tagName": "release/Nanopass/v{version}",
    "firstUnstableTag": "beta"
  },
  "inherit": true
}
