import "package://github.com/jdx/hk/releases/download/v1.20.0/hk@1.20.0#/Config.pkl"

local markdown_globs =
  List(
    "*.md",
    "*.mdx",
    "*.markdown",
  )

nwa = new Config.Step {
  glob = "**"
  exclude =
    List(
      ".editorconfig",
      "mise.lock",
    )
  check = "nwa config -c check"
  fix = new Config.Script {
    linux = "nwa config -c add 2>/dev/null"
    windows = "nwa config -c add 2>NUL"
  }
}

pkl_eval = new Config.Step {
  batch = true
  glob = "*.pkl"
  check = "python eng/scripts/hk_pkl_eval.py {{files}}"
}

pklFormat = new Config.Step {
  glob = "*.pkl"
  check = "python eng/scripts/hk_exec.py pkl format --silent -- {{files}}"
  fix = "python eng/scripts/hk_exec.py pkl format --silent --write -- {{files}}"
  stage = "*.pkl"
  batch = true
}

markdownlint_cli2 = new Config.Step {
  batch = true
  glob = markdown_globs
  stage = markdown_globs
  check = "python eng/scripts/hk_exec.py markdownlint-cli2 -- {{files}}"
  fix = "python eng/scripts/hk_exec.py markdownlint-cli2 --fix -- {{files}}"
}

typos = new Config.Step {
  batch = true
  check = "python eng/scripts/hk_exec.py typos -c .typos.toml --force-exclude -- {{files}}"
  fix = "python eng/scripts/hk_exec.py typos -c .typos.toml --force-exclude -w -- {{files}}"
}
