amends "package://github.com/jdx/hk/releases/download/v1.20.0/hk@1.20.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.20.0/hk@1.20.0#/Builtins.pkl"

import "./steps.pkl"

local generated_files =
  List(
    ".git/**",
    "coverage/**",
    "examples/hexo-site/public/**",
    "**/dist/**",
    "**/node_modules/**",
    "mise.lock",
    "Gemfile.lock",
    "**/pnpm-lock.yaml",
    "**/pnpm-workspace.yaml",
  )

local spec_kit_files =
  List(
    ".github/**",
    ".specify/**",
  )

local markdown_globs =
  List(
    "*.md",
    "*.mdx",
    "*.markdown",
  )

local default_linters = new Mapping<String, Step> {
  ["typos"] = (steps.typos) {
    exclude = generated_files
  }
  ["nwa"] = (steps.nwa) {
    exclude = generated_files + List("**/*.json")
  }
}

local configuration_linters = new Mapping<String, Step> {
  ["json-biome"] {
    local json_files = List("*.json", "*.jsonc", "*.json5")
    glob = json_files
    stage = json_files
    check =
      "python eng/scripts/hk_exec.py pnpm exec -- biome check --no-errors-on-unmatched -- {{files}}"
    fix =
      "python eng/scripts/hk_exec.py pnpm exec -- biome check --write --no-errors-on-unmatched -- {{files}}"
  }
  ["yaml-prettier"] {
    local yaml_files = List("*.yaml", "*.yml")
    glob = yaml_files
    stage = yaml_files
    exclude = generated_files
    check = "python eng/scripts/hk_exec.py pnpm exec -- prettier --check -- {{files}}"
    fix = "python eng/scripts/hk_exec.py pnpm exec -- prettier --write -- {{files}}"
  }
}

local documentation_linters = new Mapping<String, Step> {
  ["markdownlint-cli2"] {
    batch = true
    glob = markdown_globs
    stage = markdown_globs
    exclude = spec_kit_files
    check = "python eng/scripts/hk_exec.py pnpm exec -- markdownlint-cli2 -- {{files}}"
    fix = "python eng/scripts/hk_exec.py pnpm exec -- markdownlint-cli2 --fix -- {{files}}"
  }
  ["markdown-prettier"] {
    glob = markdown_globs
    stage = markdown_globs
    exclude = spec_kit_files
    check = "python eng/scripts/hk_exec.py pnpm exec -- prettier --check -- {{files}}"
    fix = "python eng/scripts/hk_exec.py pnpm exec -- prettier --write -- {{files}}"
  }
}

local javascript_linters = new Mapping<String, Step> {
  ["js-biome"] {
    local js_files =
      List(
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.ts",
        "*.tsx",
        "*.jsx",
        "*.cts",
        "*.mts",
      )
    glob = js_files
    stage = js_files
    check =
      "python eng/scripts/hk_exec.py pnpm exec -- biome check --no-errors-on-unmatched -- {{files}}"
    fix =
      "python eng/scripts/hk_exec.py pnpm exec -- biome check --write --no-errors-on-unmatched -- {{files}}"
  }
}

local pkl_linters = new Mapping<String, Step> {
  ["pkl"] = steps.pkl_eval
  ["pkl-format"] = steps.pklFormat
}

local all_linters = new Mapping<String, Step> {
  ...default_linters
  ...configuration_linters
  ...documentation_linters
  ...javascript_linters
  ...pkl_linters
}

hooks {
  ["pre-commit"] {
    fix = false
    steps = all_linters
  }
  ["pre-push"] {
    steps = all_linters
  }
  ["fix"] {
    fix = true
    steps = all_linters
  }
  ["check"] {
    steps = all_linters
  }
}
