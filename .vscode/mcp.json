{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "run",
        "--raw",
        "--quiet",
        "playwright-mcp"
      ]
    },
    "io.github.upstash/context7": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "run",
        "--raw",
        "--quiet",
        "context7-mcp"
      ]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "headers": {}
    },
    "binlog": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "exec",
        "--",
        "dotnet",
        "dnx",
        "Microsoft.AITools.BinlogMcp",
        "--yes"
      ]
    }
  },
  "inputs": []
}
