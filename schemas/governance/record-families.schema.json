{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcoona/three/schemas/governance/record-families.schema.json",
  "title": "Record Family Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "families", "bindings"],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "evaluator", "action", "fallback_review"],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "fallback_review": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "concern",
        "producer",
        "maintainer",
        "consumers",
        "creation_trigger",
        "failure_mode",
        "review_point"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "concern": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "creation_trigger": {
          "type": "string",
          "minLength": 1
        },
        "failure_mode": {
          "type": "string",
          "minLength": 1
        },
        "review_point": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "namespace", "state", "carrier", "path", "format"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": ["current", "scheduled"]
        },
        "carrier": {
          "enum": ["repository-file", "repository-files"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": ["markdown", "yaml", "json", "json-schema", "text"]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "$ref": "#/$defs/activation"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "scheduled"
              }
            },
            "required": ["state"]
          },
          "then": {
            "required": ["activation"]
          },
          "else": {
            "not": {
              "required": ["activation"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "enum": ["yaml", "json"]
              }
            },
            "required": ["format"]
          },
          "then": {
            "required": ["schema"]
          }
        }
      ]
    }
  },
  "$comment": "Derived from hcoona/microsoft-authentication-cli at 1a02498589769c38bc16eefc2efc5f9eca6e6994; copyright and MIT notice: docs/governance/reference-license.txt. Version 3 separates shared record responsibilities from project/path bindings. Binding IDs preserve version 2 family-instance IDs; independent discovery and contextual admission remain required."
}
